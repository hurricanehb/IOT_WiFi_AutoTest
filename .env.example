# 复制为 .env 后按实验室实际值填写；.env 已在 .gitignore 中，不要提交。

# --- 设备 ---
ANDROID_SERIAL=
ADB_TIMEOUT_SEC=30
DUT_ETH_IP=

# --- 日志与报告 ---
LOG_LEVEL=INFO
LOG_DIR=reports/log
REPORT_DIR=reports/html
SCREENSHOT_DIR=temp/screenshots

# --- 实验室拓扑（不填则使用 config/test_config.json 的共享默认值）---
AP_IP=
MINIAP_IP=
MINIAP2_IP=

# --- 凭据（禁止写入 config/test_config.json）---
AP_LOGIN_PASSWORD=
MINIAP_LOGIN_PASSWORD=
PYAT_AI_API_KEY=
WIFI_WEP40_PASSWORD=
WIFI_WEP104_PASSWORD=
WIFI_WEP128_PASSWORD=
OWE_TRANSITION_LAB=

# --- 性能用例（不填则使用 config/test_config.json 的 performance 节）---
PERF_IPERF_SERVER=
PERF_PING_HOST=

# --- 常用用例调优（不填则使用 config/test_config.json 的 scenario_tuning 节）---
WIFI_CONNECT_WAIT_SEC=

# 其他低频覆盖变量见 core/utils/config_loader.py。
